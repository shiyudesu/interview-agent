{
  "name": "@interview-agent/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./responses": {
      "types": "./dist/responses.d.ts",
      "default": "./dist/responses.js"
    },
    "./operation-events": {
      "types": "./dist/operation-events.d.ts",
      "default": "./dist/operation-events.js"
    },
    "./reports": {
      "types": "./dist/reports.d.ts",
      "default": "./dist/reports.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@interview-agent/domain": "workspace:*",
    "opencc-js": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
