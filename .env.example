# Local infrastructure
POSTGRES_DB=interview
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
POSTGRES_PORT=5432
DATABASE_URL=postgresql://interview:interview@localhost:5432/interview

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=interview-agent@example.test

# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PURGE_AUDIT_HASH_SECRET=replace-with-a-distinct-at-least-32-character-secret
INTERVIEW_EXPIRY_BATCH_SIZE=50
INTERVIEW_EXPIRY_MAX_BATCHES_PER_CYCLE=1000
DELETION_PURGE_BATCH_SIZE=20
DELETION_PURGE_LEASE_DURATION_MS=300000
DELETION_PURGE_RETRY_DELAY_MS=300000
DELETION_PURGE_MAX_REQUESTS_PER_CYCLE=1000
BETTER_AUTH_URL=http://localhost:3000
MODEL_PROVIDER=faux
MODEL_ID=faux
LOG_LEVEL=debug

# Optional integrations
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Base OTLP/HTTP URL; the server appends /v1/traces and rejects URL credentials or query values.
# OTEL_EXPORTER_OTLP_ENDPOINT=
