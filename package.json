{
  "name": "interview-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm workspace:check && turbo run build",
    "check": "pnpm workspace:check && biome check .",
    "clean": "turbo run clean",
    "compatibility:typescript": "tsc -p tsconfig.type-tests.json --pretty false && pnpm --parallel --filter @interview-agent/server --filter @interview-agent/web --filter @interview-agent/db run typecheck:toolchain",
    "db:generate": "turbo run db:generate",
    "db:check": "turbo run db:check",
    "db:migrate": "turbo run db:migrate",
    "dev": "turbo run dev --parallel",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "model-quality:validate": "turbo run build --filter=@interview-agent/server... && pnpm --filter @interview-agent/server test:evaluation-fixtures",
    "question-bank:validate": "tsx scripts/validate-question-bank.ts --mode development",
    "question-bank:validate:release": "tsx scripts/validate-question-bank.ts --mode release",
    "question-bank:import": "tsx scripts/import-question-bank.ts",
    "scenario-coverage:validate": "tsx scripts/validate-scenario-coverage.ts",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs --follow",
    "services:up": "docker compose up --detach --wait",
    "smoke:production": "bash scripts/smoke-production-container.sh",
    "start": "pnpm --filter @interview-agent/server start",
    "test": "pnpm test:root && turbo run test",
    "test:coverage": "turbo run build --filter=@interview-agent/db... && vitest run --config vitest.root.config.ts --coverage && turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:root": "turbo run build --filter=@interview-agent/db... && vitest run --config vitest.root.config.ts",
    "typecheck": "pnpm workspace:check && turbo run typecheck typecheck:test && tsc -p tsconfig.scripts.json --pretty false",
    "workspace:check": "node scripts/check-workspace-dependencies.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
