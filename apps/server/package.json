{
  "name": "@interview-agent/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false",
    "typecheck:toolchain": "tsc -p tsconfig.type-tests.json --pretty false"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/sensible": "catalog:",
    "@fastify/sse": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "@fastify/type-provider-typebox": "catalog:",
    "@interview-agent/contracts": "workspace:*",
    "@interview-agent/db": "workspace:*",
    "@interview-agent/domain": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "ajv-formats": "catalog:",
    "better-auth": "catalog:",
    "fastify": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "typebox": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
